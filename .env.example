# ==============================================================================
# STUDS Environment Configuration Template
# Copy this file to .env.local and populate with your API credentials.
# ==============================================================================

# Groq LPU Multi-Key Rotation Pool (Comma-separated or newline-separated)
GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2,gsk_your_key_3,gsk_your_key_4,gsk_your_key_5
NEXT_PUBLIC_GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2,gsk_your_key_3,gsk_your_key_4,gsk_your_key_5

# Default Groq Active Model (Strictly non-deprecated)
DEFAULT_GROQ_MODEL=openai/gpt-oss-120b
NEXT_PUBLIC_DEFAULT_GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter 100% Free Multimodal OCR Key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
NEXT_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
